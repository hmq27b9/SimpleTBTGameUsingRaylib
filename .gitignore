# ---------- Build output (matches your premake5.lua) ----------
bin/
obj/
build/bin/
build/obj/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app/

# Premake-generated build files
build/Makefile
build/*.make
build/*.mk
build/**/Makefile
build/**/*.make
build/.vs/
build/*.sln
build/*.vcxproj
build/*.vcxproj.*
build/*.xcodeproj/
build/premake5
premake5.exe
!build/premake5.lua

# ---------- IDE / editor ----------
.vs/
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.project
.settings/
.cproject
.classpath
compile_commands.json
.cache/

# ---------- Raylib (if you vendor a built copy) ----------
raylib/
raylib-*/
external/raylib/
# but keep any vendored *source* you explicitly commit:
!external/raylib/src/

# ---------- OS cruft ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Logs / crash dumps / temp ----------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
core
core.*
vgcore.*
*.stackdump

# ---------- Test / coverage ----------
*.gcda
*.gcno
*.gcov
coverage/
.coverage
lcov.info

# ---------- Local / secret / env ----------
.env
.env.*
*.local
secrets.*

# ---------- Caches ----------
__pycache__/     # harmless if you script build steps in Python
.ccls-cache/
.clangd/
clangd/